#!/usr/bin/env bash
# Code Ocean entrypoint: the app-panel values (storage location, samples, custom CellTypist .pkl), positionally,
# to main.py; an empty value keeps the environment variable or default (see spatial_ingest/.env.example).
# With no values it adds /data/samples to /results/spatialdata.zarr, or prints how to use the capsule.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/spatial_ingest"
exec python -u main.py "$@"
