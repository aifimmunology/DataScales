#!/usr/bin/env bash
# Code Ocean entrypoint. App-panel values arrive positionally, in panel order; an empty value keeps the
# environment variable or default (see spatial_ingest/.env.example).
#   1  storage location   a local path or s3://bucket/prefix to a SpatialData .zarr; created when missing at
#                         an s3:// prefix or at a .zarr path inside /results or /scratch
#   2  samples            Xenium/Atera bundles (folders, .zip, .tar.gz), SpatialData .zarr folders or .zarr.zip,
#                         folders holding them, or globs; comma, semicolon or newline separated. Each sample's
#                         kind is detected from its files.
#   3  custom .pkl        a CellTypist model whose labels are added to every new sample (optional)
# An older panel's four values (store, input type, samples, .pkl) are still accepted; the input type is ignored.
# Run with no values (a Reproducible Run) it adds the samples in /data/samples to a new store at
# /results/spatialdata.zarr.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/spatial_ingest"
exec python -u main.py "$@"
