# Every setting is an environment variable named after its field in config.Settings, in upper case.
# All are optional; unset means the default shown. The app panel sets STORE, INPUT_TYPE, SAMPLES and CELLTYPIST_PKL.

STORE=/results/spatialdata.zarr        # a local path or s3://bucket/prefix to a SpatialData .zarr
INPUT_TYPE=xenium                      # xenium, atera, or spatialdata (existing SpatialData .zarr)
SAMPLES=/data/samples                  # bundles (folders or .zip), SpatialData .zarr folders, folders of them, or globs
CELLTYPIST_PKL=                        # a CellTypist .pkl; its labels are added to every new sample
SAMPLE_COLUMN=sample_id                # existing SpatialData: the table column naming each cell's sample
CREATE=false                           # true to also create a missing local store outside CREATE_ROOTS (s3:// always allowed)
CREATE_ROOTS=/results,/scratch         # a missing store inside these folders is created

SCRATCH_DIR=/scratch/spatial_ingest    # extracted .zip bundles and the working copy of an S3 store
RESULTS_DIR=/results
N_JOBS=4                               # spatialdata-io Xenium reader workers
WRITE_CPUS=8                           # annizarr chunk writers for the joint table
S3_WORKERS=16                          # parallel S3 transfers
