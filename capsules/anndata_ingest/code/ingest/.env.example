# Every setting is an environment variable named after its field in config.Settings, in upper case.
# All are optional; unset means the default shown. The app panel sets STORE, ORIGIN, INPUT_TYPE, SAMPLES, CELLTYPIST_MODELS and CELLTYPIST_PKL.

SAMPLES=/data/samples              # .h5/.h5ad files, AnnData/SpatialData .zarr folders, folders of them, or globs; comma, semicolon or newline separated
STORE=/results/ingest_icechunk     # icechunk repo, or a plain AnnData zarr (a path ending in .zarr)
ORIGIN=                            # writable s3://bucket/prefix behind a read-only icechunk data asset
INPUT_TYPE=raw                     # raw (QC, CellTypist, Scrublet) or existing (AnnData/SpatialData tables as they are)
SAMPLE_COLUMN=sample_id            # existing AnnData: the obs column naming its samples (file name when missing)
CELLTYPIST_MODELS=pbmc_clean_AIFI_L1_2024,pbmc_clean_AIFI_L2_2024,pbmc_clean_AIFI_L3_2024   # a dropdown option, names in MODELS_DIR, or .pkl paths
CELLTYPIST_PKL=                    # custom CellTypist .pkl file(s), used instead of CELLTYPIST_MODELS when set
CREATE=false                       # true to also create a missing local store outside CREATE_ROOTS (s3:// is always allowed)
CREATE_ROOTS=/results,/scratch     # a missing store inside these folders is created

RUN_SCRUBLET=true                  # Scrublet and the CellTypist models are part of the store's obs schema,
RUN_CELLTYPIST=true                # fixed when it is created
MODELS_DIR=                        # default: the models bundled in code/models (see its SOURCE.json)
RANDOM_SEED=6767

CHUNK_CELLS=5000                   # cells per X chunk
WRITE_CPUS=8                       # parallel chunk writers
STAGING_DIR=/scratch/staging       # per-sample staging zarrs, deleted after each run
RESULTS_DIR=/results
