# Every setting is an environment variable named after its field in config.Settings, in upper case.
# All are optional; unset means the default shown. The app panel passes the first five as flags.

SAMPLES=/data/samples              # comma-separated .h5/.h5ad paths, or one directory of them
STORE=                             # icechunk repo, or a path ending in .zarr for a plain AnnData zarr
ORIGIN=                            # writable s3://bucket/prefix behind a read-only icechunk data asset
CELLTYPIST_MODELS=pbmc_clean_AIFI_L1_2024,pbmc_clean_AIFI_L2_2024,pbmc_clean_AIFI_L3_2024   # names in MODELS_DIR, or .pkl paths
CREATE=false                       # true to start a new store; the path must not hold one yet

RUN_SCRUBLET=true                  # Scrublet and the CellTypist models are part of the store's obs schema,
RUN_CELLTYPIST=true                # fixed when it is created
MODELS_DIR=                        # default: the models bundled in code/models (see its SOURCE.json)
RANDOM_SEED=6767

CHUNK_CELLS=5000                   # cells per X chunk
WRITE_CPUS=8                       # parallel chunk writers
STAGING_DIR=/scratch/staging       # per-sample staging zarrs, deleted after each run
RESULTS_DIR=/results
