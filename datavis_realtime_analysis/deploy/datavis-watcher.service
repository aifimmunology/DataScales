# GPU job watcher: consumes the store's jobs/submitted/ queue via gpu/job_watcher.sh.
# Install alongside datavis-app.service (which writes /etc/datavis.env at start):
#   sudo cp deploy/datavis-watcher.service /etc/systemd/system/
# Edit User= to the account whose pixi env runs jobs, and the ExecStart path
# if the checkout is not /opt/datavis/datavis_realtime_analysis.
[Unit]
Description=datavis GPU job watcher (jobs/submitted -> gpu_job.sh)
After=network-online.target datavis-app.service
Wants=network-online.target

[Service]
User=CHANGE_ME
EnvironmentFile=/etc/datavis.env
ExecStart=/opt/datavis/datavis_realtime_analysis/gpu/job_watcher.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
